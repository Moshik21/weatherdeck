{
  "$schema": "../theme.schema.json",
  "format": 1,
  "id": "default",
  "name": "Default",
  "description": "The neutral, generic look of the open-source core: dark slate plates, system faces, no art. Holds the fixed status palette, the text neutrals and the glyph set every theme inherits.",
  "extends": null,
  "spec": "docs/theme-spec.md",
  "licence": {"art": "CC0-1.0", "fonts": "none shipped (system faces)"},
  "fonts": [],
  "faces": {
    "pixel": ["ui-monospace", "Cascadia Mono", "Menlo", "Consolas", "monospace"],
    "numeral": ["Bahnschrift", "DIN Alternate", "Roboto Condensed", "system-ui", "sans-serif"],
    "data": [
      "Segoe UI Variable Text",
      "Segoe UI",
      "-apple-system",
      "SF Pro Text",
      "Ubuntu Sans",
      "Roboto",
      "Helvetica Neue",
      "Arial",
      "sans-serif"
    ],
    "load": {"font_display": "swap"},
    "adjust": {"$comment": "font-size-adjust per face, so a system face keeps the cap height the roles are sized for (Jersey 15: 15 of 27 px)", "numeral": "cap-height 0.556", "pixel": "cap-height 0.727"}
  },
  "grid": {
    "canvas_ap": [640, 360],
    "tile_ap": 8,
    "art_px_device": {"tv_4k": 6, "tv_1440p": 4, "tv_1080": 3, "phone_dpr3": 6, "phone_dpr2": 4},
    "tv_rule": "ap_dev = max(1, floor(min(viewport_w_dev / 640, viewport_h_dev / 360))); ap_css = ap_dev / devicePixelRatio",
    "phone_rule": "ap_dev = max(2, round(2 * devicePixelRatio)); ap_css = ap_dev / devicePixelRatio",
    "phone_breakpoint_css": 700,
    "pixel_font": "fp_dev = ceil(14 * devicePixelRatio / 11); label font-size = 11 * fp_dev / devicePixelRatio CSS px",
    "numeral_font": "font-size = 27 * n / devicePixelRatio CSS px for a whole n (device px per font px)",
    "centre": "offsets floored to whole device px",
    "smoothing": "image-rendering: pixelated on every bitmap; canvases at one canvas px per art px",
    "corners": "pixel steps (notch_ap), never border-radius",
    "pixelated": false
  },
  "space": {
    "$comment": "Every length is a whole number of art px. Steps, then named roles.",
    "steps_ap": [0, 1, 2, 3, 4, 6, 8, 10, 12, 16, 20, 24],
    "roles_ap": {
      "hair": 1,
      "bevel": 1,
      "notch": 1,
      "frame_call": 4,
      "gap_inline": 4,
      "gap_col": 6,
      "gap_row": 4,
      "gap_section": 8,
      "gap_zone": 6,
      "inset_plate": 10,
      "inset_call": 12,
      "inset_bar": 8,
      "margin_side": 20,
      "margin_top": 8,
      "margin_bottom": 8
    }
  },
  "type": {
    "$comment": "Same roles and sizes as every theme (the core lays out by role). The default theme uses system faces, so 'pixel' means the system monospace and the arcminutes assume a cap of about 0.7 em; the integer grid still applies to layout.",
    "floor_arcmin": 16,
    "glance_arcmin": 20,
    "hero_arcmin": 60,
    "roles": {
      "label": {
        "face": "pixel",
        "size_ap": 11,
        "line_ap": 11,
        "weight": 400,
        "case": "upper",
        "font_px_per_art_px": 1,
        "cap_ap": 8.0,
        "tv_4k": {"font_dev_px": 66, "cap_dev_px": 48.0, "arcmin_3m_55in": 17.4, "arcmin_3m_65in": 20.6},
        "tv_1080": {"font_dev_px": 33, "cap_dev_px": 24.0},
        "phone": {"css_px": 14.667, "line_css_px": 16, "rule": "pixel_font", "arcmin_35cm_dpr3": 17.4},
        "use": "labels, state words, ages, ranges, machine names, log header"
      },
      "label_lg": {
        "face": "pixel",
        "size_ap": 22,
        "line_ap": 22,
        "weight": 400,
        "case": "upper",
        "font_px_per_art_px": 2,
        "cap_ap": 16.0,
        "tv_4k": {"font_dev_px": 132, "cap_dev_px": 96.0, "arcmin_3m_55in": 34.9, "arcmin_3m_65in": 41.3},
        "tv_1080": {"font_dev_px": 66, "cap_dev_px": 48.0},
        "phone": {"css_px": 18.333, "line_css_px": 20, "rule": "pixel_font", "arcmin_35cm_dpr3": 21.7},
        "use": "HAILING in place of the countdown digit while a try is in flight"
      },
      "numeral": {
        "face": "numeral",
        "size_ap": 27,
        "line_ap": 16,
        "weight": 400,
        "font_px_per_art_px": 1,
        "cap_ap": 15.0,
        "tv_4k": {"font_dev_px": 162, "cap_dev_px": 90.0, "arcmin_3m_55in": 32.7, "arcmin_3m_65in": 38.7},
        "tv_1080": {"font_dev_px": 81, "cap_dev_px": 45.0},
        "phone": {"css_px": 27, "line_css_px": 18, "rule": "numeral_font", "arcmin_35cm_dpr3": 24.4},
        "use": "clock, landed score, all-clear count line"
      },
      "numeral_hero": {
        "face": "numeral",
        "size_ap": 54,
        "line_ap": 30,
        "weight": 400,
        "font_px_per_art_px": 2,
        "cap_ap": 30.0,
        "tv_4k": {"font_dev_px": 324, "cap_dev_px": 180.0, "arcmin_3m_55in": 65.4, "arcmin_3m_65in": 77.3},
        "tv_1080": {"font_dev_px": 162, "cap_dev_px": 90.0},
        "phone": {"css_px": 54, "line_css_px": 32, "rule": "numeral_font", "arcmin_35cm_dpr3": 48.8},
        "use": "the count on the call band (the biggest number on the board)"
      },
      "numeral_clock_rest": {
        "face": "numeral",
        "size_ap": 81,
        "line_ap": 46,
        "weight": 400,
        "font_px_per_art_px": 3,
        "cap_ap": 45.0,
        "tv_4k": {"font_dev_px": 486, "cap_dev_px": 270.0, "arcmin_3m_55in": 98.1, "arcmin_3m_65in": 116.0},
        "tv_1080": {"font_dev_px": 243, "cap_dev_px": 135.0},
        "use": "the anchor (sleep) clock, TV only"
      },
      "numeral_countdown": {
        "face": "numeral",
        "size_ap": 108,
        "line_ap": 61,
        "weight": 400,
        "font_px_per_art_px": 4,
        "cap_ap": 60.0,
        "tv_4k": {"font_dev_px": 648, "cap_dev_px": 360.0, "arcmin_3m_55in": 130.7, "arcmin_3m_65in": 154.6},
        "tv_1080": {"font_dev_px": 324, "cap_dev_px": 180.0},
        "phone": {"css_px": 81, "line_css_px": 48, "rule": "numeral_font", "arcmin_35cm_dpr3": 73.2},
        "use": "seconds to the next hail (host down)"
      },
      "title": {
        "face": "data",
        "size_ap": 13,
        "line_ap": 15,
        "weight": 680,
        "cap_ap": 8.68,
        "tv_4k": {"font_dev_px": 78, "cap_dev_px": 52.1, "arcmin_3m_55in": 18.9, "arcmin_3m_65in": 22.4},
        "tv_1080": {"font_dev_px": 39, "cap_dev_px": 26.1},
        "phone": {"css_px": 19, "line_css_px": 24, "arcmin_35cm_dpr3": 20.7},
        "use": "top call title, alarm title"
      },
      "title_log": {
        "face": "data",
        "size_ap": 12,
        "line_ap": 14,
        "weight": 650,
        "cap_ap": 8.02,
        "tv_4k": {"font_dev_px": 72, "cap_dev_px": 48.1, "arcmin_3m_55in": 17.5, "arcmin_3m_65in": 20.7},
        "tv_1080": {"font_dev_px": 36, "cap_dev_px": 24.0},
        "phone": {"css_px": 18, "line_css_px": 23, "arcmin_35cm_dpr3": 19.6},
        "use": "lane titles in the ship's log"
      },
      "statement": {
        "face": "data",
        "size_ap": 16,
        "line_ap": 19,
        "weight": 650,
        "cap_ap": 10.69,
        "tv_4k": {"font_dev_px": 96, "cap_dev_px": 64.1, "arcmin_3m_55in": 23.3, "arcmin_3m_65in": 27.6},
        "tv_1080": {"font_dev_px": 48, "cap_dev_px": 32.1},
        "phone": {"css_px": 21, "line_css_px": 26, "arcmin_35cm_dpr3": 22.8},
        "use": "'Nothing waits on you.' on the anchor plate; hailing sentence"
      },
      "notice_title": {
        "face": "data",
        "size_ap": 14,
        "line_ap": 17,
        "weight": 680,
        "cap_ap": 9.35,
        "tv_4k": {"font_dev_px": 84, "cap_dev_px": 56.1, "arcmin_3m_55in": 20.4, "arcmin_3m_65in": 24.1},
        "tv_1080": {"font_dev_px": 42, "cap_dev_px": 28.1},
        "phone": {"css_px": 19, "line_css_px": 24, "arcmin_35cm_dpr3": 20.7},
        "use": "lost-contact and empty notices"
      },
      "body": {
        "face": "data",
        "size_ap": 11,
        "line_ap": 13,
        "weight": 450,
        "cap_ap": 7.35,
        "tv_4k": {"font_dev_px": 66, "cap_dev_px": 44.1, "arcmin_3m_55in": 16.0, "arcmin_3m_65in": 18.9},
        "tv_1080": {"font_dev_px": 33, "cap_dev_px": 22.0},
        "phone": {"css_px": 16, "line_css_px": 21, "arcmin_35cm_dpr3": 17.4},
        "use": "where to act, other calls, log details, bar sub-lines: the TV floor"
      },
      "body_quiet": {
        "face": "data",
        "size_ap": 12,
        "line_ap": 15,
        "weight": 450,
        "cap_ap": 8.02,
        "tv_4k": {"font_dev_px": 72, "cap_dev_px": 48.1, "arcmin_3m_55in": 17.5, "arcmin_3m_65in": 20.7},
        "tv_1080": {"font_dev_px": 36, "cap_dev_px": 24.0},
        "phone": {"css_px": 16, "line_css_px": 21, "arcmin_35cm_dpr3": 17.4},
        "use": "the one quiet line on the anchor plate"
      }
    },
    "numerals": "tabular-nums",
    "tracking": 0,
    "phone_floor_css_px": 15
  },
  "color": {
    "$comment": "status and ink are core: every theme inherits them unchanged. surface is this theme's fill of the core roles.",
    "status": {
      "day": {"needs": "#F7B733", "trouble": "#FF5F4A", "moving": "#5C9DFF", "done": "#93DDB4"},
      "night": {"needs": "#C49023", "trouble": "#D55240", "moving": "#4974B5", "done": "#6A717B"},
      "sleep": {"needs": "#C49023", "trouble": "#D55240", "moving": "#4974B5", "done": "#6A717B"}
    },
    "ink": {
      "day": {"ink": "#E8ECF1", "ink2": "#B4BDC9", "fog": "#8D97A5"},
      "night": {"ink": "#8F9397", "ink2": "#747B85", "fog": "#747B85"},
      "sleep": {"ink": "#868B91", "ink2": "#7A8088", "fog": "#7A8088", "clock": "#6A7078"}
    },
    "surface": {
      "day": {
        "glyph_ink": "#080A0E",
        "ground": "#0E1217",
        "panel": "#151A22",
        "panel_hi": "#2A3240",
        "panel_lo": "#080A0E",
        "rule": "#2A3240",
        "track": "#222A36",
        "call": "#1B2230",
        "call_edge": "#F7B733",
        "call_ink": "#E8ECF1",
        "call_ink2": "#B4BDC9",
        "call_band": "#F7B733",
        "call_band_ink": "#1C1206"
      },
      "night": {
        "glyph_ink": "#000000",
        "ground": "#07090C",
        "panel": "#0B0E12",
        "panel_hi": "#1A1F27",
        "panel_lo": "#000000",
        "rule": "#1A1F27",
        "track": "#14181E",
        "call": "#0B0E12",
        "call_edge": "#C49023",
        "call_ink": "#8F9397",
        "call_ink2": "#747B85",
        "call_band": "#C49023",
        "call_band_ink": "#0C0804"
      },
      "sleep": {
        "glyph_ink": "#000000",
        "ground": "#000000",
        "panel": "#020304",
        "panel_hi": "#0E1116",
        "panel_lo": "#000000",
        "rule": "#0C0F13",
        "track": "#0A0C10",
        "call": "#020304",
        "call_edge": "#C49023",
        "call_ink": "#868B91",
        "call_ink2": "#7A8088",
        "call_band": "#C49023",
        "call_band_ink": "#0C0804"
      }
    }
  },
  "glyphs": {
    "file": "glyphs.json",
    "size_ap": 12,
    "pip_ap": 8,
    "states": {
      "call": {"glyph": "needs", "slot": "needs", "word": "YOUR CALL", "tier": "action"},
      "approval": {"glyph": "approve", "slot": "needs", "word": "MERGE READY", "tier": "action"},
      "capacity": {"glyph": "needs", "slot": "needs", "word": "YOUR CALL", "tier": "action"},
      "critical": {"glyph": "failed", "slot": "trouble", "word": "CRITICAL", "tier": "critical"},
      "failed": {"glyph": "failed", "slot": "trouble", "word": "FAILED", "tier": "critical"},
      "blocked": {"glyph": "blocked", "slot": "ink", "word": "BLOCKED", "tier": "caution"},
      "agent_gone": {"glyph": "needs", "slot": "needs", "word": "AGENT GONE", "tier": "action"},
      "long": {"glyph": "long", "slot": "ink", "word": "RUNNING LONG", "tier": "caution"},
      "regressed": {"glyph": "regressed", "slot": "ink", "word": "ROUND {n}", "tier": "caution"},
      "mate": {"glyph": "mate", "slot": "ink2", "word": "ASKED LEAD", "tier": "caution"},
      "unknown": {"glyph": "silent", "slot": "fog", "word": "NO WORD", "tier": "caution"},
      "moving": {"glyph": "moving", "slot": "moving", "word": "{step}", "tier": "normal"},
      "scout": {"glyph": "scout", "slot": "moving", "word": "SCOUTING", "tier": "normal"},
      "done": {"glyph": "done", "slot": "done", "word": "LANDED", "tier": "normal"},
      "pr_open": {"glyph": "mate", "slot": "done", "word": "PR OPEN", "tier": "normal"},
      "pr_unread": {"glyph": "silent", "slot": "fog", "word": "PR RECORDED", "tier": "caution"},
      "asleep": {"glyph": "asleep", "slot": "fog", "word": "ASLEEP", "tier": "normal"}
    },
    "pips": {
      "ok": {"pip": "ok", "slot": "ink2", "word": "OK"},
      "warn": {"pip": "warn", "slot": "ink", "word": "{reason}"},
      "draining": {"pip": "rest", "slot": "ink2", "word": "DRAINING"}, "reserved": {"pip": "rest", "slot": "ink2", "word": "RESERVED"}, "maintenance": {"pip": "rest", "slot": "ink2", "word": "MAINTENANCE"},
      "alert": {"pip": "down", "slot": "trouble", "word": "ALERT"},
      "down": {"pip": "down", "slot": "trouble", "word": "NOT ANSWERING"},
      "lost": {"pip": "silent", "slot": "fog", "word": "LOST {t}"},
      "silent": {"pip": "silent", "slot": "fog", "word": "SILENT {t}"},
      "live": {"pip": "lamp", "slot": "ink", "word": "LIVE"},
      "late": {"pip": "lamp", "slot": "ink2", "word": "LATE"},
      "stale": {"pip": "silent", "slot": "fog", "word": "STALE"}
    },
    "outline": "surface.panel_lo"
  },
  "zones": {
    "tv": {
      "$comment": "The generic board: no scene. Same grid and roles as every theme.",
      "bar": {"x": 20, "y": 8, "w": 600, "h": 27},
      "call": {"x": 20, "y": 41, "w": 356, "h_max": 164, "rows_max": 4},
      "machines": {"x": 384, "y": 41, "w": 236, "h": 164, "per": "one row per machine: pip, name, word, vitals"},
      "log": {"x": 20, "y": 213, "w": 600, "h": 139, "rows_max": 6, "wraps_max": 1},
      "hail": {"x": 384, "y": 41, "w": 236, "h": 164, "when": "host down (replaces the machines panel)"},
      "since": {"x": 384, "y": 173, "w": 160, "h": 32, "when": "the screen comes back after display.since_last.min_away_min: landed, new calls, newly stuck"},
      "key": {"x": 596, "y": 173, "w": 24, "h": 15, "holds": "the key's button (also the ? key)"},
      "lists": {"x": 548, "y": 173, "w": 45, "h": 15, "holds": "the door to the page board (#/board), left of the key; it grows leftwards for a longer word; never on the television profile"},
      "legend": {"x": 384, "y": 41, "w": 236, "h": 147, "when": "the key is open: every glyph shape with its word"},
      "anchor": {"plate": {"x": 140, "y": 102, "w": 360, "h": 156}, "when": "sleep"}
    },
    "phone": {
      "order": ["bar", "call", "log", "more"],
      "gutter_css": 16,
      "call": {"top_max_css": 320},
      "anchor": "not used"
    }
  },
  "motion": {
    "$comment": "Announce once, then rest (research b.2-13, c.7). Durations in ms; 'steps' = discrete frames, never eased.",
    "levels": {
      "full": "arrivals, one-shot transitions, idle crew loops on lanes that changed in the last idle.window_s (at most idle.max_sprites)",
      "calm": "arrivals and one-shot transitions; a changed lane's crew sprite plays idle.calm_burst_s then rests; no continuous loop",
      "still": "no animation; every change is instant"
    },
    "default": {
      "tv": "calm",
      "phone": "full",
      "night": "calm without idle",
      "sleep": "still after the transition in"
    },
    "reduced_motion": "prefers-reduced-motion or config motion=still: every transition becomes an instant change (or a cross-fade of at most 100 ms); no idle; the hail countdown and the clock still update, as plain digit swaps",
    "durations_ms": {
      "frame": 100,
      "crow_flight": 600,
      "open": 400,
      "resolve": 250,
      "step_finish": 300,
      "landing": 600,
      "counter_max": 1000,
      "regress_flash": 200,
      "fog_roll": 600,
      "fog_lift": 600,
      "storm_flash": 1500,
      "anchor_in": 800,
      "anchor_out": 400,
      "bell_strike": 400,
      "flag_hoist": 400,
      "lamp_out": 300
    },
    "steps": {
      "open": 4,
      "step_finish": 3,
      "counter_max": 7,
      "fog_roll": 4,
      "fog_lift": 4,
      "anchor_in": 4,
      "anchor_out": 2,
      "bell_strike": 2,
      "flag_hoist": 4,
      "lamp_out": 1,
      "crow_flight": 6
    },
    "blink": {
      "hz": 2,
      "max_blinks": 3,
      "max_simultaneous": 1,
      "events": ["call_band_on_arrival", "critical_edge_on_arrival", "storm_lightning_on_arrival"],
      "never": [
        "text",
        "glyphs",
        "the anchor screen",
        "the hailing plate",
        "quiet hours except a new call or critical"
      ]
    },
    "bounce": {"count": 2, "ms": 600, "steps": 3, "shift_ap": 3, "what": "the count on the call band"},
    "idle": {
      "frames": 2,
      "frame_ms": 500,
      "max_sprites": 6,
      "window_s": 600,
      "calm_burst_s": 4,
      "night": 0,
      "what": "crew sprites whose lane changed step or reported in the window; nothing else idles (no waves, clouds, smoke, lantern or flags)"
    },
    "per_second": ["the hail countdown digit"],
    "per_minute": ["the clock (HH:MM)", "ages after the first hour"]
  },
  "burn_in": {
    "drift": {
      "step_ap": 1,
      "every_s": 240,
      "box_ap": [3, 2],
      "path": [[0, 0], [1, 0], [2, 0], [2, 1], [1, 1], [0, 1]],
      "moves": "all plates together; the scene canvas stays put (it changes on its own with the sky)",
      "under_reduced_motion": "kept: one whole-art-px jump every 4 min is not perceived motion"
    },
    "anchor_drift": {
      "step_ap": 1,
      "every_s": 240,
      "box_ap": [16, 8],
      "path": "clockwise round the box edge (48 positions, 3 h 12 min a lap)",
      "moves": "the anchor plate, the ship and the crow together"
    },
    "fill_max_oklch_l": 0.25,
    "fill_exceptions": ["the call plate by day (the one light block)", "text", "glyphs", "bars no taller than 4 ap"],
    "bright_static": "no static logo or wordmark; chrome labels in ink2",
    "varies_on_its_own": ["sky by time of day", "clock", "ages", "crew poses"],
    "anchor_budget": {
      "mean_relative_luminance_max": 0.01,
      "lit_pixel_share_max": 0.03,
      "lit_pixel": "relative luminance above 0.18"
    }
  },
  "crt": {"default": false, "available": false},
  "dither": {"pattern": "bayer-4x4", "uses": ["the stale half of a range bar"]},
  "components": {
    "plate": {"fill": "panel", "bevel_hi": "panel_hi", "bevel_lo": "panel_lo", "notch_ap": 0, "bevel_ap": 1},
    "call": {
      "fill": "call",
      "frame": ["call_edge 2"],
      "band": {"fill": "call_band", "ink": "call_band_ink", "count": "numeral_hero"}
    },
    "log": {
      "overflow": "as ship-deck: rows_max - 1 rows, then '+N more: ...'",
      "last_known": "state word kept, LAST KNOWN beside it"
    },
    "anchor": {
      "when": "as ship-deck",
      "palette": "sleep",
      "plate": "clock, 'Nothing waits on you.', one quiet line, trust line; no art"
    },
    "hail": {
      "when": "as ship-deck",
      "plate": "heading 'NO ANSWER FROM THE HOST', seconds to the next try, the three fact rows; no art"
    }
  },
  "words": {},
  "checks": {
    "method": "WCAG 2 contrast ratio; CVD = OKLab distance x 100 after Machado 2009 simulation at severity 1 (research c.4)",
    "contrast": [
      {
        "mode": "day",
        "fg": "ink",
        "bg": "panel",
        "ratio": 14.72,
        "floor": 4.5,
        "pass": true,
        "use": "body text on plates"
      },
      {
        "mode": "day",
        "fg": "ink2",
        "bg": "panel",
        "ratio": 9.2,
        "floor": 4.5,
        "pass": true,
        "use": "secondary text on plates"
      },
      {
        "mode": "day",
        "fg": "fog",
        "bg": "panel",
        "ratio": 5.91,
        "floor": 4.5,
        "pass": true,
        "use": "last-known and silent text"
      },
      {
        "mode": "day",
        "fg": "ink",
        "bg": "ground",
        "ratio": 15.84,
        "floor": 4.5,
        "pass": true,
        "use": "text on the ground (phone gutters)"
      },
      {
        "mode": "day",
        "fg": "needs",
        "bg": "panel",
        "ratio": 9.79,
        "floor": 3.0,
        "pass": true,
        "use": "needs-you glyphs and the state word YOUR CALL"
      },
      {
        "mode": "day",
